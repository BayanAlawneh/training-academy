# ==========================================================================
#  بناء على مرحلتين
#
#  Render لا يوفّر بيئة Java جاهزة على الخطة المجانية، فنبنيها بـ Docker.
#  المرحلة الأولى تُجمّع المشروع، والثانية تحمل النتيجة فقط — فتخرج صورة
#  أصغر بكثير لأنها لا تحتوي Maven ولا الشيفرة المصدرية.
# ==========================================================================

# ---------- المرحلة 1: البناء ----------
FROM maven:3.9-eclipse-temurin-17 AS build

WORKDIR /app

# ننسخ pom.xml وحده أولاً ونحمّل الاعتماديات.
# هذه الطبقة تُخزَّن مؤقّتاً، فتغيير الشيفرة لا يعيد تحميل الاعتماديات
# ما لم يتغيّر pom.xml نفسه — وهذا يقصّر البناءات التالية كثيراً.
COPY pom.xml .
RUN mvn dependency:go-offline -B

COPY src ./src
RUN mvn clean package -DskipTests -B

# ---------- المرحلة 2: التشغيل ----------
FROM eclipse-temurin:17-jre

WORKDIR /app

# اسم الأرشيف غير مثبّت: النمط يلتقطه أياً كان رقم النسخة في pom.xml،
# فلا يتعطّل النشر عند رفع النسخة.
COPY --from=build /app/target/*.jar app.jar

# Render يمرّر رقم المنفذ في PORT، وspring يقرأه من application.properties
EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
